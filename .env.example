# Environment Configuration Example
# Copy this file to .env and fill in your values

# Microsoft OAuth Configuration
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
# Redirect URI must match the one configured in Azure App Registration
# Default: https://localhost/login/authorized
REDIRECT_URI=https://localhost/login/authorized

# Microsoft Graph API Configuration
# Choose between v1.0 or beta (default: beta)
# v1.0 provides stable APIs, beta provides preview features
GRAPH_API_VERSION=beta

# Development OAuth Settings (Only for development environments)
# Uncomment these lines if you need to use HTTP (not HTTPS) for OAuth during development
# WARNING: Do NOT use these in production!
# OAUTHLIB_INSECURE_TRANSPORT=1
# OAUTHLIB_RELAX_TOKEN_SCOPE=1
# OAUTHLIB_IGNORE_SCOPE_CHANGE=1

# API Configuration
# Set a custom base path for all endpoints (optional)
# Example: API_PREFIX=/secret/api will make endpoints like /secret/api/lists
API_PREFIX=

# API Key Protection (optional)
# Set to true to enable API key authentication for business endpoints
# When enabled, all API endpoints except documentation and initial auth endpoints require X-API-KEY header
# Protected: /auth/status, /auth/logout, /lists/*, /tasks/*
# Unprotected: /health, /docs, /redoc, /openapi.json, /auth/login, /auth/callback*
ENABLE_API_KEY=false
# If ENABLE_API_KEY is true, set the API key here
X_API_KEY=your_api_key_here

# Token Management
# Path to store authentication tokens (must be persistent across container restarts)
TOKEN_CACHE_PATH=./token_cache

# Server Configuration
HOST=0.0.0.0
PORT=8000

# HTML Rendering Configuration for E-ink Display
# Set to true to enable query-based authentication for HTML rendering routes
# When enabled, HTML routes require ?passwd=<password> query parameter
ENABLE_QUERY_AUTH=false
# If ENABLE_QUERY_AUTH is true, set the password here
QUERY_PASSWD=your_query_password_here
